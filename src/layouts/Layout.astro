---
import { Font } from 'astro:assets';
import '@/styles/global.css';
import Header from '@/components/app/Header.astro';
import Footer from '@/components/app/Footer.astro';
import { Toaster } from "@/components/starwind/toast";
import seoData from '@/data/seo.yaml';

const currentLocale = Astro.currentLocale || 'en';
const seo = seoData[currentLocale];
---

<!doctype html>
<html lang={currentLocale} dir={currentLocale === 'ar' ? 'rtl' : 'ltr'} class="scroll-smooth">
  <head>
    <Font cssVariable="--font-sans" preload />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" href={seo?.siteLogo || "/favicon.ico"} />
    <title>{seo?.siteTitle || "Royal Forwarding FZCO"}</title>
    <meta name="description" content={seo?.siteDescription || ""} />
  </head>
  <body>
    <Header lang={currentLocale} />
    <main class="overflow-x-clip">
      <slot />
    </main>
    <Toaster position="bottom-right" />
    <Footer lang={currentLocale} />
  </body>
</html>
